# Copy to .env and fill values. DO NOT commit .env

# Local development
APP_ENV=development
BASE_URL=http://localhost/mamoven1

DB_HOST=localhost
DB_NAME=mamaove
DB_USER=root
DB_PASS=your_local_db_password
DB_CHARSET=utf8mb4

# Use "auto" to prefer mail() on InfinityFree and SMTP elsewhere when credentials exist.
# You can still force "mail" or "smtp" manually.
EMAIL_TRANSPORT=auto
MAIL_FROM=you@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password_here
SMTP_SECURE=tls

# InfinityFree production example (uncomment and replace values in your real .env)
# APP_ENV=production
# BASE_URL=https://your-subdomain.infinityfreeapp.com/mamoven1
# DB_HOST=sqlXXX.epizy.com
# DB_NAME=if0_xxxxxxxx_mamaove
# DB_USER=if0_xxxxxxxx
# DB_PASS=your_infinityfree_db_password
# DB_CHARSET=utf8mb4
# EMAIL_TRANSPORT=mail
# MAIL_FROM=mamasovenug@gmail.com