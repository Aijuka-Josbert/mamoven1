# Copy to .env and fill values locally. DO NOT commit .env

APP_ENV=development
BASE_URL=http://localhost/mamoven1

DB_HOST=localhost
DB_NAME=mamaove
DB_USER=root
DB_PASS=your_db_password_here
DB_CHARSET=utf8mb4

# Use "auto" to prefer mail on InfinityFree and SMTP elsewhere when credentials exist.
# You can still force "mail" or "smtp" manually.
EMAIL_TRANSPORT=auto
ADMIN_EMAIL=you@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password_here
SMTP_SECURE=tls